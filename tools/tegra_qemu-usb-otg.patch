+    uint32_t td[NUM_EPS][2];        /* dTD in progress, 0: none */
+    uint32_t done[NUM_EPS][2];      /* its bytes moved so far */
+    bool zlp[NUM_EPS][2];           /* IN: zero-length packet still owed */
