+static int tegra_usb_can_read(void *opaque)
+{
+    tegra_usb *s = opaque;
+
+    return sizeof(s->rx) - s->rxlen;
+}
+
+static void tegra_usb_link_read(void *opaque, const uint8_t *buf, int size)
+{
+    tegra_usb *s = opaque;
+    uint8_t resp[3 + LINK_MAX];
+
+    memcpy(s->rx + s->rxlen, buf, size);
+    s->rxlen += size;
+    while (s->rxlen >= 4) {
+        uint8_t op = s->rx[0], ep = s->rx[1] & 0xF;
+        uint32_t len = lduw_le_p(s->rx + 2);
+        uint32_t plen = op == OP_SETUP || op == OP_OUT ? len : 0;
+        uint32_t rlen = 0;
+        int st;
+
+        if (plen > LINK_MAX || (op == OP_SETUP && len != 8)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "tegra.usb: bad link request '%c'\n", op);
+            s->rxlen = 0;
+            return;
+        }
+        if (s->rxlen < 4 + plen) {
+            return;
+        }
+        switch (op) {
+        case OP_QUERY:
+            resp[3] = dev_attached(s) | (dev_high_speed(s) << 1);
+            resp[4] = s->devaddr >> 25;
+            rlen = 2;
+            st = ST_ACK;
+            break;
+        case OP_RESET:
+            st = dev_bus_reset(s);
+            break;
+        case OP_SETUP:
+            st = dev_setup(s, s->rx + 4);
+            break;
+        case OP_IN:
+            st = dev_in(s, ep, MIN(len, LINK_MAX), resp + 3, &rlen);
+            break;
+        case OP_OUT:
+            st = dev_out(s, ep, s->rx + 4, len);
+            break;
+        default:
+            st = ST_STALL;
+            break;
+        }
+        resp[0] = st;
+        stw_le_p(resp + 1, rlen);
+        qemu_chr_fe_write_all(&s->chr, resp, 3 + rlen);
+        s->rxlen -= 4 + plen;
+        memmove(s->rx, s->rx + 4 + plen, s->rxlen);
+    }
+}
+
+static void tegra_usb_link_event(void *opaque, QEMUChrEvent event)
+{
+    tegra_usb *s = opaque;
+
+    if (event == CHR_EVENT_OPENED || event == CHR_EVENT_CLOSED) {
+        /* Cable plugged or pulled: a new host starts from reset. */
+        s->host = event == CHR_EVENT_OPENED;
+        s->bus_reset = false;
+        s->rxlen = 0;
+        if (dev_attached(s)) {
+            s->usbsts |= STS_PCI;
+            dev_update_irq(s);
+        }
+    }
+}
