+/*
+ * Device mode (USBMODE.CM = 2): the ChipIdea-style device controller used
+ * by the boot ROM for RCM and by hekate (bdk/usb/usbd.c). Queue heads sit
+ * at ENDPOINTLISTADDR (the controller's own RAM at +0x1000, or DRAM),
+ * transfer descriptors and buffers in DRAM.
+ *
+ * The USB bus goes to chardev "chardev": a virtual host (nxk
+ * tools/usbterm.py) sends one request per USB token and gets the
+ * device's handshake back.
+ *   request:  op, endpoint, length (LE16), payload (SETUP: 8, OUT: length)
+ *   response: status, length (LE16), payload (IN data, QUERY state)
+ */
+#define DEV_REGS_BASE   0x100
+#define DEV_REGS_SIZE   0x160
+
+#define R_CAPS          0x100
+#define R_DCIVERSION    0x120
+#define R_DCCPARAMS     0x124
+#define R_USBCMD        0x130
+#define R_USBSTS        0x134
+#define R_USBINTR       0x138
+#define R_FRINDEX       0x13C
+#define R_DEVICEADDR    0x144
+#define R_EPLISTADDR    0x148
+#define R_PORTSC1       0x174
+#define R_DEVLC         0x1B4
+#define R_OTGSC         0x1F4
+#define R_USBMODE       0x1F8
+#define R_ENDPTNAK      0x200
+#define R_ENDPTNAKEN    0x204
+#define R_SETUPSTAT     0x208
+#define R_PRIME         0x20C
+#define R_FLUSH         0x210
+#define R_STATUS        0x214
+#define R_COMPLETE      0x218
+#define R_EPCTRL0       0x21C
+#define NUM_EPS         16
+
+#define CMD_RUN         BIT(0)
+#define CMD_RST         BIT(1)
+#define CMD_SUTW        BIT(13)
+#define STS_UI          BIT(0)
+#define STS_PCI         BIT(2)
+#define STS_URI         BIT(6)
+#define STS_W1C         0x5FF
+#define PORTSC_CCS      BIT(0)
+#define PORTSC_PE       BIT(2)
+#define PORTSC_HSP      BIT(9)
+#define PORTSC_PFSC     BIT(24)
+#define DEVLC_PSPD_SHIFT 25
+#define OTGSC_ID        BIT(8)
+#define OTGSC_AVV       BIT(9)
+#define OTGSC_ASV       BIT(10)
+#define OTGSC_BSV       BIT(11)
+#define OTGSC_BSE       BIT(12)
+#define OTGSC_STS_MASK  (0x7F << 16)
+#define MODE_CM_MASK    3
+#define MODE_CM_DEVICE  2
+#define EPCTRL_RXS      BIT(0)
+#define EPCTRL_RXR      BIT(6)
+#define EPCTRL_RXE      BIT(7)
+#define EPCTRL_TXS      BIT(16)
+#define EPCTRL_TXR      BIT(22)
+#define EPCTRL_TXE      BIT(23)
+
+#define QH_SIZE         64
+#define QH_CAPS         0x00
+#define QH_CUR          0x04
+#define QH_NEXT         0x08
+#define QH_TOKEN        0x0C
+#define QH_SETUP        0x28
+#define QH_CAPS_IOS     BIT(15)
+#define QH_CAPS_ZLT_DIS BIT(29)
+#define TD_NEXT         0x00
+#define TD_TOKEN        0x04
+#define TD_PAGE0        0x08
+#define TD_TERMINATE    BIT(0)
+#define TOK_ACTIVE      BIT(7)
+#define TOK_IOC         BIT(15)
+#define TOK_BYTES_MASK  (0x7FFFu << 16)
+
+enum { OP_QUERY = 'Q', OP_RESET = 'R', OP_SETUP = 'S', OP_IN = 'I', OP_OUT = 'O' };
+enum { ST_ACK = 'A', ST_NAK = 'N', ST_STALL = 'S', ST_DATA = 'D' };
+#define LINK_MAX        1024
+
 typedef struct tegra_usb_state {
     EHCISysBusState parent_obj;
 
