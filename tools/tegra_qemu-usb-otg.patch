 static const VMStateDescription vmstate_tegra_usb = {
     .name = "tegra.usb",
     .version_id = 1,
@@ -59,6 +173,574 @@ static const VMStateDescription vmstate_tegra_usb = {
     }
 };
 
+static EHCIState *tegra_usb_ehci(tegra_usb *s)
+{
+    return &s->parent_obj.ehci;
+}
+
+/* Guest memory; the queue-head RAM directly (no re-entrant MMIO). */
+static bool dev_qram(tegra_usb *s, hwaddr a, unsigned len)
+{
+    hwaddr b = s->iomem_queue.addr;
+
+    return a >= b && a + len <= b + sizeof(s->regs_queue);
+}
+
+static uint32_t dev_rd32(tegra_usb *s, hwaddr a)
+{
+    uint32_t v = 0;
+
+    if (dev_qram(s, a, 4)) {
+        return s->regs_queue[(a - s->iomem_queue.addr) >> 2];
+    }
+    address_space_read(&address_space_memory, a, MEMTXATTRS_UNSPECIFIED, &v, 4);
+    return le32_to_cpu(v);
+}
+
+static void dev_wr32(tegra_usb *s, hwaddr a, uint32_t v)
+{
+    if (dev_qram(s, a, 4)) {
+        s->regs_queue[(a - s->iomem_queue.addr) >> 2] = v;
+        return;
+    }
+    v = cpu_to_le32(v);
+    address_space_write(&address_space_memory, a, MEMTXATTRS_UNSPECIFIED, &v, 4);
+}
+
+static uint32_t ep_bit(int ep, int dir)
+{
+    return BIT(ep + (dir ? 16 : 0));
+}
+
+static hwaddr dev_qh(tegra_usb *s, int ep, int dir)
+{
+    return (s->eplist & ~0x7FFu) + (ep * 2 + dir) * QH_SIZE;
+}
+
+static bool dev_attached(tegra_usb *s)
+{
+    return s->dev_mode && (s->usbcmd & CMD_RUN);
+}
+
+static bool dev_high_speed(tegra_usb *s)
+{
+    return !(s->portsc & PORTSC_PFSC);
+}
+
+static void dev_update_irq(tegra_usb *s)
+{
+    if (s->dev_mode) {
+        qemu_set_irq(tegra_usb_ehci(s)->irq, !!(s->usbsts & s->usbintr & STS_W1C));
+    }
+}
+
+static void dev_enter(tegra_usb *s, uint32_t mode)
+{
+    s->usbcmd = s->usbsts = s->usbintr = s->devaddr = s->eplist = 0;
+    s->portsc = s->devlc = s->otgsc = 0;
+    s->setupstat = s->status = s->complete = s->nak = s->naken = 0;
+    memset(s->dregs, 0, sizeof(s->dregs));
+    memset(s->epctrl, 0, sizeof(s->epctrl));
+    memset(s->td, 0, sizeof(s->td));
+    memset(s->done, 0, sizeof(s->done));
+    memset(s->zlp, 0, sizeof(s->zlp));
+    s->bus_reset = false;
+    s->usbmode = mode;
+    s->dev_mode = true;
+    memory_region_set_enabled(&s->iomem_dev, true);
+}
+
+static void dev_leave(tegra_usb *s)
+{
+    if (s->dev_mode) {
+        qemu_set_irq(tegra_usb_ehci(s)->irq, 0);
+    }
+    s->dev_mode = false;
+    s->bus_reset = false;
+    memory_region_set_enabled(&s->iomem_dev, false);
+    s->regs_controller[(R_USBMODE - 0x1B4) >> 2] = s->usbmode;
+}
+
+/* Start the dTD at `td` on an endpoint: copy it into the queue head. */
+static void dev_load(tegra_usb *s, int ep, int dir, uint32_t td)
+{
+    hwaddr qh = dev_qh(s, ep, dir);
+    uint32_t tok = dev_rd32(s, td + TD_TOKEN);
+
+    s->td[ep][dir] = 0;
+    s->status &= ~ep_bit(ep, dir);
+    if (!(tok & TOK_ACTIVE)) {
+        return;
+    }
+    s->td[ep][dir] = td;
+    s->done[ep][dir] = 0;
+    s->zlp[ep][dir] = false;
+    s->status |= ep_bit(ep, dir);
+    dev_wr32(s, qh + QH_CUR, td);
+    dev_wr32(s, qh + QH_NEXT, dev_rd32(s, td + TD_NEXT));
+    dev_wr32(s, qh + QH_TOKEN, tok);
+}
+
+/* Write back the dTD and its queue-head copy with `left` bytes to go. */
+static void dev_set_left(tegra_usb *s, int ep, int dir, uint32_t left, bool retire)
+{
+    uint32_t td = s->td[ep][dir];
+    uint32_t tok = dev_rd32(s, td + TD_TOKEN);
+
+    tok = (tok & ~TOK_BYTES_MASK) | (left << 16);
+    if (retire) {
+        tok &= ~TOK_ACTIVE;
+    }
+    dev_wr32(s, td + TD_TOKEN, tok);
+    dev_wr32(s, dev_qh(s, ep, dir) + QH_TOKEN, tok);
+}
+
+static void dev_complete(tegra_usb *s, int ep, int dir, uint32_t left)
+{
+    uint32_t td = s->td[ep][dir];
+    uint32_t next;
+
+    dev_set_left(s, ep, dir, left, true);
+    s->complete |= ep_bit(ep, dir);
+    if (dev_rd32(s, td + TD_TOKEN) & TOK_IOC) {
+        s->usbsts |= STS_UI;
+    }
+    next = dev_rd32(s, td + TD_NEXT);
+    s->td[ep][dir] = 0;
+    s->status &= ~ep_bit(ep, dir);
+    if (!(next & TD_TERMINATE)) {
+        dev_load(s, ep, dir, next & ~0x1Fu);
+    }
+    dev_update_irq(s);
+}
+
+static void dev_prime(tegra_usb *s, uint32_t bits)
+{
+    for (int b = 0; b < 32; b++) {
+        int ep = b & 15, dir = b >> 4;
+        uint32_t next;
+
+        if (!(bits & BIT(b)) || (s->status & BIT(b))) {
+            continue;
+        }
+        next = dev_rd32(s, dev_qh(s, ep, dir) + QH_NEXT);
+        if (!(next & TD_TERMINATE)) {
+            dev_load(s, ep, dir, next & ~0x1Fu);
+        }
+    }
+}
+
+static void dev_flush(tegra_usb *s, uint32_t bits)
+{
+    for (int b = 0; b < 32; b++) {
+        if (bits & BIT(b)) {
+            s->td[b & 15][b >> 4] = 0;
+        }
+    }
+    s->status &= ~bits;
+}
+
+/* Move `len` bytes between `buf` and the dTD buffer at byte `off`. */
+static void dev_copy(tegra_usb *s, uint32_t td, uint32_t off, uint8_t *buf,
+                     uint32_t len, bool to_guest)
+{
+    uint32_t page0 = dev_rd32(s, td + TD_PAGE0);
+
+    while (len) {
+        uint32_t pos = (page0 & 0xFFF) + off;
+        uint32_t idx = pos >> 12;
+        hwaddr a;
+        uint32_t n;
+
+        if (idx > 4) {
+            qemu_log_mask(LOG_GUEST_ERROR, "tegra.usb: dTD 0x%x overrun\n", td);
+            return;
+        }
+        a = (idx ? dev_rd32(s, td + TD_PAGE0 + 4 * idx) : page0) & ~0xFFFu;
+        a += pos & 0xFFF;
+        n = MIN(len, 0x1000 - (pos & 0xFFF));
+        if (to_guest) {
+            address_space_write(&address_space_memory, a, MEMTXATTRS_UNSPECIFIED, buf, n);
+        } else {
+            address_space_read(&address_space_memory, a, MEMTXATTRS_UNSPECIFIED, buf, n);
+        }
+        buf += n;
+        off += n;
+        len -= n;
+    }
+}
+
+static uint32_t dev_max_packet(tegra_usb *s, int ep, int dir, uint32_t *caps)
+{
+    uint32_t mps;
+
+    *caps = dev_rd32(s, dev_qh(s, ep, dir) + QH_CAPS);
+    mps = (*caps >> 16) & 0x7FF;
+    return mps ? mps : 64;
+}
+
+static uint32_t dev_ctrl(tegra_usb *s, int ep)
+{
+    /* Control endpoint 0 is always enabled. */
+    return ep ? s->epctrl[ep] : s->epctrl[0] | EPCTRL_RXE | EPCTRL_TXE;
+}
+
+static int dev_setup(tegra_usb *s, const uint8_t *pkt)
+{
+    hwaddr qh = dev_qh(s, 0, 0);
+
+    if (!dev_attached(s) || !s->bus_reset) {
+        return ST_NAK;
+    }
+    dev_wr32(s, qh + QH_SETUP, ldl_le_p(pkt));
+    dev_wr32(s, qh + QH_SETUP + 4, ldl_le_p(pkt + 4));
+    /* A SETUP clears the control endpoint stall and the setup tripwire. */
+    s->epctrl[0] &= ~(EPCTRL_RXS | EPCTRL_TXS);
+    s->usbcmd &= ~CMD_SUTW;
+    s->setupstat |= BIT(0);
+    if (dev_rd32(s, qh + QH_CAPS) & QH_CAPS_IOS) {
+        s->usbsts |= STS_UI;
+    }
+    dev_update_irq(s);
+    return ST_ACK;
+}
+
+static int dev_in(tegra_usb *s, int ep, uint32_t maxlen, uint8_t *out, uint32_t *outlen)
+{
+    uint32_t ctrl = dev_ctrl(s, ep);
+    uint32_t td, caps, mps, left, n;
+
+    *outlen = 0;
+    if (!dev_attached(s) || !s->bus_reset) {
+        return ST_NAK;
+    }
+    if (ctrl & EPCTRL_TXS) {
+        return ST_STALL;
+    }
+    td = s->td[ep][1];
+    if (!(ctrl & EPCTRL_TXE) || !td) {
+        return ST_NAK;
+    }
+    if (s->zlp[ep][1]) {
+        dev_complete(s, ep, 1, 0);
+        return ST_DATA;
+    }
+    mps = dev_max_packet(s, ep, 1, &caps);
+    left = (dev_rd32(s, td + TD_TOKEN) & TOK_BYTES_MASK) >> 16;
+    n = MIN(MIN(left, mps), maxlen);
+    dev_copy(s, td, s->done[ep][1], out, n, false);
+    s->done[ep][1] += n;
+    left -= n;
+    *outlen = n;
+    if (left && n == mps) {
+        dev_set_left(s, ep, 1, left, false);
+    } else if (!left && n && n == mps && !(caps & QH_CAPS_ZLT_DIS)) {
+        /* Transfer ends on a full packet: a zero-length one follows. */
+        dev_set_left(s, ep, 1, 0, false);
+        s->zlp[ep][1] = true;
+    } else {
+        dev_complete(s, ep, 1, left);
+    }
+    return ST_DATA;
+}
+
+static int dev_out(tegra_usb *s, int ep, uint8_t *data, uint32_t len)
+{
+    uint32_t ctrl = dev_ctrl(s, ep);
+    uint32_t td, caps, mps, left, n;
+
+    if (!dev_attached(s) || !s->bus_reset) {
+        return ST_NAK;
+    }
+    if (ctrl & EPCTRL_RXS) {
+        return ST_STALL;
+    }
+    td = s->td[ep][0];
+    if (!(ctrl & EPCTRL_RXE) || !td) {
+        return ST_NAK;
+    }
+    mps = dev_max_packet(s, ep, 0, &caps);
+    left = (dev_rd32(s, td + TD_TOKEN) & TOK_BYTES_MASK) >> 16;
+    n = MIN(len, left);
+    if (n < len) {
+        qemu_log_mask(LOG_GUEST_ERROR, "tegra.usb: EP%d OUT babble (%u > %u)\n", ep, len, left);
+    }
+    dev_copy(s, td, s->done[ep][0], data, n, true);
+    s->done[ep][0] += n;
+    left -= n;
+    if (left && len == mps) {
+        dev_set_left(s, ep, 0, left, false);
+    } else {
+        /* Buffer full or short packet: the transfer is over. */
+        dev_complete(s, ep, 0, left);
+    }
+    return ST_ACK;
+}
+
+static int dev_bus_reset(tegra_usb *s)
+{
+    if (!dev_attached(s)) {
+        return ST_NAK;
+    }
+    s->bus_reset = true;
+    s->usbsts |= STS_URI | STS_PCI;
+    dev_update_irq(s);
+    return ST_ACK;
+}
+
+static uint32_t dev_portsc(tegra_usb *s)
+{
+    uint32_t v = s->portsc & ~(PORTSC_CCS | PORTSC_PE | PORTSC_HSP);
+
+    if (s->host && dev_attached(s)) {
+        v |= PORTSC_CCS;
+        if (s->bus_reset) {
+            v |= PORTSC_PE | (dev_high_speed(s) ? PORTSC_HSP : 0);
+        }
+    }
+    return v;
+}
+
+static uint64_t tegra_usb_dev_read(void *opaque, hwaddr offset, unsigned size)
+{
+    tegra_usb *s = opaque;
+    hwaddr a = DEV_REGS_BASE + (offset & ~3);
+    uint32_t v;
+
+    switch (a) {
+    case R_CAPS ... R_CAPS + 0xC:
+        v = ldl_le_p(&tegra_usb_ehci(s)->caps[a - R_CAPS]);
+        break;
+    case R_DCIVERSION:
+        v = 0x0001;
+        break;
+    case R_DCCPARAMS:
+        v = BIT(8) | BIT(7) | NUM_EPS; /* host and device capable */
+        break;
+    case R_USBCMD:
+        v = s->usbcmd;
+        break;
+    case R_USBSTS:
+        v = s->usbsts;
+        break;
+    case R_USBINTR:
+        v = s->usbintr;
+        break;
+    case R_FRINDEX:
+        v = (qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 125000) & 0x3FFF;
+        break;
+    case R_DEVICEADDR:
+        v = s->devaddr;
+        break;
+    case R_EPLISTADDR:
+        v = s->eplist;
+        break;
+    case R_PORTSC1:
+        v = dev_portsc(s);
+        break;
+    case R_DEVLC:
+        v = s->devlc & ~(3u << DEVLC_PSPD_SHIFT);
+        if (s->bus_reset && dev_high_speed(s)) {
+            v |= 2u << DEVLC_PSPD_SHIFT;
+        }
+        break;
+    case R_OTGSC:
+        v = (s->otgsc & ~0xFF00u) | OTGSC_ID;
+        v |= s->host ? OTGSC_AVV | OTGSC_ASV | OTGSC_BSV : OTGSC_BSE;
+        break;
+    case R_USBMODE:
+        v = s->usbmode;
+        break;
+    case R_ENDPTNAK:
+        v = s->nak;
+        break;
+    case R_ENDPTNAKEN:
+        v = s->naken;
+        break;
+    case R_SETUPSTAT:
+        v = s->setupstat;
+        break;
+    case R_PRIME:
+    case R_FLUSH:
+        v = 0; /* primes and flushes finish at once */
+        break;
+    case R_STATUS:
+        v = s->status;
+        break;
+    case R_COMPLETE:
+        v = s->complete;
+        break;
+    case R_EPCTRL0 ... R_EPCTRL0 + 4 * (NUM_EPS - 1):
+        v = dev_ctrl(s, (a - R_EPCTRL0) >> 2);
+        break;
+    default:
+        v = s->dregs[(a - DEV_REGS_BASE) >> 2];
+        break;
+    }
+    v >>= (offset & 3) * 8;
+    return size >= 4 ? v : v & ((1u << (size * 8)) - 1);
+}
+
+static void tegra_usb_dev_write(void *opaque, hwaddr offset, uint64_t value,
+                                unsigned size)
+{
+    tegra_usb *s = opaque;
+    hwaddr a = DEV_REGS_BASE + (offset & ~3);
+    uint32_t v = value;
+
+    if (size < 4) {
+        uint32_t shift = (offset & 3) * 8, mask = ((1u << (size * 8)) - 1) << shift;
+
+        v = (tegra_usb_dev_read(s, offset & ~3, 4) & ~mask) | ((v << shift) & mask);
+    }
+
+    switch (a) {
+    case R_USBCMD:
+        if (v & CMD_RST) {
+            /* Controller reset: back to idle mode, host registers. */
+            s->usbmode = 0;
+            dev_leave(s);
+            return;
+        }
+        s->usbcmd = v;
+        if (!(v & CMD_RUN)) {
+            s->bus_reset = false;
+        }
+        break;
+    case R_USBSTS:
+        s->usbsts &= ~(v & STS_W1C);
+        break;
+    case R_USBINTR:
+        s->usbintr = v;
+        break;
+    case R_DEVICEADDR:
+        s->devaddr = v & 0xFF000000;
+        break;
+    case R_EPLISTADDR:
+        s->eplist = v & ~0x7FFu;
+        break;
+    case R_PORTSC1:
+        s->portsc = v;
+        break;
+    case R_DEVLC:
+        s->devlc = v;
+        break;
+    case R_OTGSC:
+        s->otgsc = (s->otgsc & OTGSC_STS_MASK & ~(v & OTGSC_STS_MASK)) | (v & ~OTGSC_STS_MASK);
+        break;
+    case R_USBMODE:
+        s->usbmode = v;
+        if ((v & MODE_CM_MASK) != MODE_CM_DEVICE) {
+            dev_leave(s);
+            return;
+        }
+        break;
+    case R_ENDPTNAK:
+        s->nak &= ~v;
+        break;
+    case R_ENDPTNAKEN:
+        s->naken = v;
+        break;
+    case R_SETUPSTAT:
+        s->setupstat &= ~v;
+        break;
+    case R_PRIME:
+        dev_prime(s, v);
+        break;
+    case R_FLUSH:
+        dev_flush(s, v);
+        break;
+    case R_STATUS:
+        break;
+    case R_COMPLETE:
+        s->complete &= ~v;
+        break;
+    case R_EPCTRL0 ... R_EPCTRL0 + 4 * (NUM_EPS - 1):
+        s->epctrl[(a - R_EPCTRL0) >> 2] = v & ~(EPCTRL_RXR | EPCTRL_TXR);
+        break;
+    default:
+        s->dregs[(a - DEV_REGS_BASE) >> 2] = v;
+        break;
+    }
+    dev_update_irq(s);
+}
