 }
 
 static void tegra_gpio_priv_reset(DeviceState *dev)
@@ -370,6 +373,39 @@
     }
 }
 
+/* Level-triggered pins (INT_LVL edge and delta bits clear) at their active
+ * level latch INT_STA; a bank's line is up while an enabled status is. */
+static void tegra_gpio_update(tegra_gpio *s, int bank)
+{
+    int pending = 0;
+
+    for (int port = 0; port < PORTS_NB; port++) {
+        tegra_gpio_port *p = &s->regs[bank * PORTS_NB + port];
+        uint32_t on = p->gpio_cnf.reg32 & p->gpio_int_enb.reg32 & 0xFF;
+        uint32_t lvl = p->gpio_int_lvl.reg32;
+        uint32_t level = on & ~((lvl >> 8) | (lvl >> 16)) & 0xFF;
+        uint32_t active = ~(p->gpio_in.reg32 ^ lvl) & 0xFF;
+
+        p->gpio_int_sta.reg32 |= level & active;
+        pending |= (p->gpio_int_sta.reg32 & on) != 0;
+    }
+    qemu_set_irq(s->irq[bank], pending);
+}
+
+/* Input pin n = (bank * PORTS_NB + port) * 8 + bit, driven by a device. */
+static void tegra_gpio_set_pin(void *opaque, int n, int level)
+{
+    tegra_gpio *s = opaque;
+    tegra_gpio_port *p = &s->regs[n / 8];
+
+    if (level) {
+        p->gpio_in.reg32 |= 1u << (n % 8);
+    } else {
+        p->gpio_in.reg32 &= ~(1u << (n % 8));
+    }
+    tegra_gpio_update(s, n / 8 / PORTS_NB);
+}
+
 static const MemoryRegionOps tegra_gpio_mem_ops = {
     .read = tegra_gpio_priv_read,
     .write = tegra_gpio_priv_write,
